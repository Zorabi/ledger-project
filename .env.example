# PostgreSQL
DATABASE_POSTGRES_HOST=127.0.0.1
DATABASE_POSTGRES_PORT=5432
DATABASE_POSTGRES_USER=postgres
DATABASE_POSTGRES_PASSWORD=change_me
DATABASE_POSTGRES_DBNAME=ledger
DATABASE_POSTGRES_SSL_MODE=disable
DATABASE_POSTGRES_AUTO_CREATE=true
DATABASE_POSTGRES_AUTO_MIGRATE=true

# Application
APP_VERSION=1.6.0.0
JWT_SECRET=change_me_to_a_long_random_secret
APP_ENCRYPTION_KEY=change_me_and_keep_it_safe
AUDIT_RETENTION_DAYS=30

# Email backup
EMAIL_HOST=
EMAIL_PORT=0
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Logging
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_PATH=logs/ledger-backend.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
